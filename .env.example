# Required for protected API use
PHISHGUARD_API_KEY=replace-with-a-long-random-inference-key
PHISHGUARD_ADMIN_KEY=replace-with-a-separate-long-random-admin-key

# Runtime
AUTH_REQUIRED=true
# Keep model-only predictions advisory until the real-world challenge gate passes.
ML_BLOCKING_ENABLED=false
CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
PHISHGUARD_FEED_DIR=/app/live_feeds
FEEDBACK_DB_PATH=/app/runtime/feedback.sqlite3
INFERENCE_THREADS=1
CASCADE_ENABLED=true
CASCADE_LOW_THRESHOLD=0.20
CASCADE_HIGH_THRESHOLD=0.80
SHADOW_SAMPLE_RATE=0
MAX_BATCH_SIZE=10000
MAX_BATCH_CHARS=1000000
MAX_REQUEST_BODY_BYTES=2000000

# Threat feed refresh. The OpenPhish community feed is 12-hourly;
# use the refresh interval allowed by your OpenPhish plan. URLhaus bulk dumps
# are generated every 5 minutes and should not be fetched more often than that.
OPENPHISH_FEED_URL=https://www.openphish.com/feed.txt
OPENPHISH_MIRROR_URL=https://raw.githubusercontent.com/openphish/public_feed/refs/heads/main/feed.txt
OPENPHISH_REFRESH_SECONDS=43200
FEED_RETRY_SECONDS=900
URLHAUS_AUTH_KEY=
URLHAUS_REFRESH_SECONDS=300

# Optional remote enrichment; never enabled on the public hot path by default.
ENRICHMENT_ENABLED=false
REMOTE_ENRICHMENT_ADMIN_ONLY=true
GOOGLE_WEB_RISK_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
PHISHTANK_APP_KEY=

# High-margin model cache entries live longer than near-threshold scores.
CACHE_CONFIDENT_TTL_SECONDS=900
CACHE_UNCERTAIN_TTL_SECONDS=60
DEEP_ANALYSIS_ON_UNCERTAIN=false
DEEP_ANALYSIS_TIMEOUT_SECONDS=2.0
DEEP_ANALYSIS_MAX_CONCURRENCY=32
